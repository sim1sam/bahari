{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:deploy": "vite build && node scripts/verify-build.mjs",
        "build:git": "npm run build:deploy && git add public/build",
        "package:deploy": "node scripts/package-build.mjs",
        "deploy": "npm run build:deploy && npm run package:deploy",
        "dev": "vite"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "alpinejs": "^3.15.12"
    }
}
